PORT=3000
MONGODB_URI=
MONGODB_DB=novelly
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated website origins allowed to call this API from a browser,
# e.g. https://novelly.example.com (localhost is already allowed in development).
CORS_ORIGINS=
# Set to false in production so only CORS_ORIGINS are allowed.
ALLOW_LOCALHOST_ORIGINS=true
